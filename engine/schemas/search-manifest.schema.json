{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExperienceBuild Search Manifest",
  "type": "object",
  "required": ["status", "pages", "robots_txt", "sitemap", "redirect_map", "entity_graph", "indexnow"],
  "properties": {
    "status": {"enum": ["COMPLETE", "BLOCKED"]},
    "pages": {"type": "array", "minItems": 1},
    "robots_txt": {"type": "object"},
    "sitemap": {"type": "object"},
    "redirect_map": {"type": "array"},
    "entity_graph": {"type": "object"},
    "indexnow": {"type": "object"}
  }
}

