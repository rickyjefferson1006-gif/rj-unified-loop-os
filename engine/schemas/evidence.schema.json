{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchBuild Evidence",
  "type": "object",
  "required": ["status", "sources"],
  "properties": {
    "status": {"enum": ["COMPLETE", "BLOCKED"]},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "source_type", "accessed_at", "claims"],
        "properties": {
          "id": {"type": "string", "pattern": "^E-[0-9]{3,}$"},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "source_type": {"enum": ["official", "paper", "repository", "standard", "advisory", "registry", "analysis"]},
          "accessed_at": {"type": "string", "format": "date-time"},
          "claims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}

